{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "闪电树懒",
  "version": "0.1.1",
  "identifier": "com.lightningsloth.aios",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "闪电树懒",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 750,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "maximizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    },
    "resources": {
      "../../src/": "backend/src/",
      "../../scripts/": "backend/scripts/",
      "../../skills/": "backend/skills/",
      "../../sandbox/": "backend/sandbox/",
      "../../music/": "backend/music/",
      "../../package.json": "backend/package.json",
      "../../node_modules/": "backend/node_modules/",
      "../../resources/node.exe": "backend/node.exe"
    }
  }
}
